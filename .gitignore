.pytest_cache/
.coverage
htmlcov/
.tox/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Local credentials — never commit.
.env
.env.*

# Experiment data / sweep outputs — never commit binary parquets.
# `experiments/data/` is a generated cache from `collect_*.py`
# scripts; reproduce by re-running, don't push the binaries.
# Exceptions:
# - `_remote.json` cloud-archive manifests are tiny pointers that
#   make `corroborate restore` discoverable from a clean checkout.
# - `experiments/data/cache/` per-hypothesis caches are small
#   (single-digit MB) and committed alongside the snapshot reports
#   so the regression sentinel test (`test_run_report_snapshot_
#   regression`) can re-run hypotheses on a clean CI checkout
#   without restoring the multi-GB raw corpus from cloud.
experiments/data/**
!experiments/data/**/
!experiments/data/**/_remote.json
!experiments/data/cache/
!experiments/data/cache/*.parquet
!experiments/data/cache/*.hashes.json
*.parquet
!experiments/data/cache/*.parquet

# Claude Code local state
.claude/

# Mutation testing scratch — `mutmut` copies the source tree into
# `mutants/` and runs each mutant's pytest there; gigabytes of
# transient state, never committed.
mutants/
.mutmut-cache

# Post-run JSON report write tempfiles (atomic-write via tmp + rename).
# The committed reports themselves live at experiments/findings/<short>.run.json
# and ARE tracked.
*.run.json.tmp
